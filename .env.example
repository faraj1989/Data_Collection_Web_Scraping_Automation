# Every download folder below is unique to its own scraper. Each scraper only
# watches its own folder for "whatever new file appeared" - a shared folder
# lets one scraper steal another's export mid-download. Don't repoint two of
# these at the same path.
MAE_HISTORICAL_DOWNLOAD_DIR=C:\\NOC_Data\\Input\\Downloads\\MAE_Historical
MAE_HISTORICAL_EXPORT_BASE_DIR=C:\\NOC_Data\\Output\\Historical_Alarms
MAE_HISTORICAL_DOWNLOAD_TIMEOUT=600
MAE_HISTORICAL_INTERVAL_SECONDS=300

